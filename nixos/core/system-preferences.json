{
  "hostname": "main",
  "timezone": "Europe/Berlin",
  "locale": "en_US.UTF-8",
  "firewall": {
    "enable": true,
    "allowedTCPPorts": []
  },
  "ssh": {
    "enable": false
  },
  "autoOptimiseStore": false,
  "zramSwap": {
    "enable": true,
    "memoryPercent": 50
  },
  "security": {
    "coredumpDisabled": true,
    "secureBoot": false,
    "unprivilegedBpfDisabled": true
  },
  "storage": {
    "encryptedSwap": true,
    "tmpfsTmp": true
  },
  "trust": {
    "launcherIntegration": false,
    "flatpakNarrowing": true
  },
  "vault": {
    "autoLock": "30m"
  }
}
